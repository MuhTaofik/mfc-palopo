# -----------------------------------------------------------------------------
# Aplikasi MULTI FITNES CENTRE (MFC) Palopo
# -----------------------------------------------------------------------------
# Panduan Produksi:
# 1. Ubah APP_ENV=production dan APP_DEBUG=false
# 2. Atur APP_URL ke domain HTTPS resmi (contoh: https://mfc-palopo.com)
# 3. Jalankan 'php artisan key:generate' sekali pada awal instalasi.
#    PERINGATAN: Jangan pernah generate ulang APP_KEY setelah transaksi berjalan (E1).
# -----------------------------------------------------------------------------
APP_NAME="MFC Palopo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Di produksi: Gunakan user non-root dengan kata sandi kuat dan akses terbatas.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mfc_palopo
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Kredensial Awal Akun Admin (E3 Keamanan)
# -----------------------------------------------------------------------------
# Digunakan oleh AdminSeeder saat pertama kali setup database.
# Wajib ditentukan sebelum menjalankan 'php artisan db:seed'.
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=

# -----------------------------------------------------------------------------
# Manajemen Sesi & Cookie (E6 Keamanan)
# -----------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=mfc_palopo_session
# Pengaturan flag Secure pada cookie sesi (E6 Keamanan):
# - Secara default OTOMATIS AKTIF (true) saat APP_ENV=production demi keamanan HTTPS.
# - Secara default OTOMATIS NON-AKTIF (false) saat APP_ENV=local agar akses HTTP Laragon lancar.
# - Sengaja dikomentari agar fallback otomatis berbasis APP_ENV bekerja.
# - Hapus tanda pagar (#) dan set true/false hanya jika ingin memaksakan secara manual.
# SESSION_SECURE_COOKIE=

# -----------------------------------------------------------------------------
# Trusted Proxies (E6 Keamanan)
# -----------------------------------------------------------------------------
# Daftar IP / CIDR reverse proxy yang dipercayai (misal: Cloudflare, Nginx, ALB).
# Kosongkan jika koneksi direct ke server (mencegah pemalsuan header X-Forwarded-For).
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@mfc-palopo.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
